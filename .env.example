# ============================================================
# Configuration de l'application PingMeDaddy
# ============================================================
# Copier ce fichier vers .env et adapter les valeurs :
#   cp .env.example .env

# === IDENTIFICATION APPLICATION ===
APP_SLUG=pmd
APP_NAME=PingMeDaddy
APP_DESCRIPTION=Network monitoring — ping, latency, traceroute

# === PORTS ===
# Port de l'API backend
API_PORT=6666
# Port du frontend (serveur statique)
FRONTEND_PORT=3000

# === HOST DE CETTE APPLICATION ===
# IP ou hostname par lequel cette application sera accessible
#
# CAS 1 - App sur le MÊME serveur que le Hub :
#   Laisser vide → utilisera automatiquement HUB_HOST
#
# CAS 2 - App sur un serveur DIFFÉRENT du Hub :
#   Définir l'IP du serveur où l'app est déployée (ex: 192.168.1.200)
#   Cette IP sera transmise au Hub lors de l'enregistrement
APP_HOST=

# === HUB ===
# IP/hostname du serveur Hub
# En local (même machine) : host.docker.internal
# En réseau : IP du serveur Hub (ex: 192.168.1.126)
HUB_HOST=host.docker.internal
HUB_API_PORT=8000
HUB_FRONTEND_PORT=80

# === BASE DE DONNÉES ===
DATABASE_URL=postgresql+asyncpg://pingmedaddy:pingmedaddy@pmd-db:5432/pingmedaddy

# === ENVIRONNEMENT ===
DEBUG=false

# === M2M (MACHINE-TO-MACHINE) ===
# Permettre l'accès aux ressources via le système M2M du Hub
# Si true, d'autres applications pourront accéder à cette app via tokens M2M
IS_SHARED=false

# === PMD SPÉCIFIQUE ===
PING_TIMEOUT=1.0
PING_CONCURRENCY_LIMIT=200
TRACEROUTE_BINARY=

# Mode développement - Génération automatique des clés JWT si absentes
# ⚠️ DÉSACTIVER EN PRODUCTION (les clés doivent être pré-existantes)
AUTO_GENERATE_KEYS=false

# Auto-remplacement des applications existantes lors de l'enregistrement
# Si true : l'ancienne app et son M2M sont supprimés automatiquement
# Si false : conserve l'app existante avec ses credentials (recommandé)
FORCE_REPLACE_APP=false

# Clé de chiffrement des secrets des service accounts (Fernet)
# Générée avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Ne pas perdre cette clé : les secrets chiffrés ne seront plus déchiffrables sans elle
SECRETS_ENCRYPTION_KEY=

# Synchronisation automatique avec Docker (en secondes)
# Scanne les conteneurs Docker et désactive les apps dont le conteneur est arrêté
# 0 = désactivé, 300 = toutes les 5 minutes (recommandé)
DOCKER_SYNC_INTERVAL=300

# Cooldown pour les notifications SSE d'audit (en secondes)
# Évite les rafraîchissements trop fréquents de la page audit
# 5 = une notification toutes les 5 secondes max
AUDIT_SSE_COOLDOWN=5.0

# Rétention des logs d'audit (en jours)
# Les logs plus anciens seront automatiquement supprimés
# 0 = pas de purge automatique (conserver indéfiniment)
AUDIT_RETENTION_DAYS=90

# Rétention des logs d'erreurs HTTP (en jours)
# Les erreurs plus anciennes seront automatiquement supprimées
# 0 = pas de purge automatique
ERROR_RETENTION_DAYS=30

# Intervalle de purge des logs (en heures)
# Fréquence à laquelle le système vérifie et supprime les anciens logs
LOG_PURGE_INTERVAL_HOURS=24

# Whitelist des réseaux autorisés pour l'auto-enregistrement des applications
# Par défaut : réseaux Docker (172.17-31.*)
# Format : préfixes IP séparés par des virgules
# Exemples :
#   - "172.17.,172.18." = réseaux Docker bridge uniquement
#   - "172.17.,172.18.,192.168.50." = Docker + réseau local spécifique
#   - "10.0.42." = réseau overlay spécifique
# ⚠️ SÉCURITÉ : N'ajoutez que les réseaux de confiance !
APP_WHITELIST_NETWORKS="192.,172.,10."

# =============================================================================
# PKI - Gestion des Certificats SSL/TLS
# =============================================================================
# HTTPS est activé automatiquement si les certificats existent dans certs/server/hub/
# Commandes : python pki.py init && python pki.py cert create hub

# Port HTTPS (443 par défaut)
HUB_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Autorité de Certification (CA) - Informations d'identité
# -----------------------------------------------------------------------------
# Ces valeurs apparaissent dans le certificat racine (purement informatif)
PKI_CA_COMMON_NAME=Hub Local CA
PKI_CA_ORGANIZATION=Hub Internal
PKI_CA_VALIDITY_YEARS=10

# -----------------------------------------------------------------------------
# Certificats Serveur - Configuration technique
# -----------------------------------------------------------------------------
# Domaines DNS inclus dans les certificats (le navigateur vérifie la correspondance)
# ⚠️ Ajoutez ici tous les noms d'hôte utilisés pour accéder au Hub
PKI_CERT_DOMAINS=localhost,hub.local,hub-frontend

# IPs supplémentaires (l'IP du serveur est auto-détectée via HUB_HOST)
PKI_CERT_IPS=

# Validité des certificats serveur (recommandé : 365 jours pour rotation annuelle)
PKI_CERT_VALIDITY_DAYS=365

# Taille des clés RSA : 2048 (standard) ou 4096 (haute sécurité)
PKI_KEY_SIZE=4096
HOST_UID=1000
